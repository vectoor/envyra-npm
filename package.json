{
  "name": "envyra",
  "version": "0.1.4",
  "description": "Define your environment once. Validate it at startup. Use it type-safely everywhere.",
  "keywords": [
    "environment",
    "env",
    "env-vars",
    "typescript",
    "validation",
    "config",
    "configuration",
    "node",
    "type-safe",
    "dotenv"
  ],
  "license": "MIT",
  "author": "vector <vectormsk90@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vectoor/envyra.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "bin": {
    "envyra": "./dist/cli.js"
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "vitest run --typecheck",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:types && npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "jiti": "^2.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.14.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
